# Variabili d'ambiente - copiare in .env.local e riempire i valori.
# Non committare mai il file .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server, mai esposta al client
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend ---
RESEND_API_KEY=
# Mittente delle email transazionali, su dominio verificato
RESEND_FROM_EMAIL=no-reply@angeloparruchiere.it

# --- Sito ---
NEXT_PUBLIC_SITE_URL=https://angeloparruchiere.it

# --- Iubenda ---
NEXT_PUBLIC_IUBENDA_SITE_ID=
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=
